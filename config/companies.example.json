  "indeed_config": {
    "pass_2_pm_anchored": {
      "keywords": [
        "Product Manager target-lane-keyword",
        "Product Manager adjacent-lane-keyword"
      ],
      "us_locations": [
        "Target State",
        "Target Metro",
        "Remote"
      ]
    }
  },
  "slug_invalid_history": [],
  "ats_endpoints": {
    "greenhouse": {
      "endpoint_template": "https://boards-api.greenhouse.io/v1/boards/{slug}/jobs?content=true",
      "method": "GET",
      "fetcher": "web_fetch"
    },
    "ashby": {
      "endpoint_template": "https://api.ashbyhq.com/posting-api/job-board/{slug}",
      "method": "GET",
      "fetcher": "web_fetch",
      "_comment": "Do not append includeCompensation=true by default; some tenants reject it. Parse compensation from descriptionHtml when structured compensation is absent."
    },
    "lever": {
      "endpoint_template": "https://api.lever.co/v0/postings/{slug}?mode=json",
      "method": "GET",
      "fetcher": "web_fetch"
    },
    "workday": {
      "search_endpoint_template": "https://{host}/wday/cxs/{tenant}/{site}/jobs",
      "search_method": "POST",
      "search_body_template": {
        "appliedFacets": {},
        "limit": 20,
        "offset": 0,
        "searchText": "{search_text}"
      },
      "search_text_variants": [
        "Product Manager",
        "Senior Product Manager",
        "AI Product Manager"
      ],
      "fetcher": "bash_curl",
      "required_headers": {
        "Cache-Control": "no-cache, no-store",
        "Pragma": "no-cache"
      },
      "_comment": "Use curl subprocess with no-cache headers. Run Workday before Greenhouse to reduce stale proxy-cache responses. Keep limit at 20; some Workday tenants reject larger values."
    }
  }
}
